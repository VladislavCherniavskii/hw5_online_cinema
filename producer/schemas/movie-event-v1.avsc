{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "com.hw5.cinema",
  "doc": "Version 1 of an online cinema user activity event.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "UUID string uniquely identifying the event."},
    {"name": "user_id", "type": "string"},
    {"name": "movie_id", "type": "string"},
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": ["VIEW_STARTED", "VIEW_FINISHED", "VIEW_PAUSED", "VIEW_RESUMED", "LIKED", "SEARCHED"]
      }
    },
    {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "Event time in UTC."},
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"]
      }
    },
    {"name": "session_id", "type": "string"},
    {"name": "progress_seconds", "type": "int", "doc": "Current playback position in seconds."}
  ]
}
